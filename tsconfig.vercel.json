{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"],
      "trackfleet-runtime-env": ["./app/lib/runtime-env.vercel.ts"],
      "trackfleet-delivery-store": ["./app/lib/delivery-store.vercel.ts"],
      "trackfleet-site-store": ["./app/lib/site-store.vercel.ts"]
    }
  },
  "exclude": [
    "node_modules",
    "app/lib/delivery-store.cloudflare.ts",
    "app/lib/runtime-env.cloudflare.ts",
    "app/lib/site-store.cloudflare.ts",
    "worker/**/*",
    "db/**/*"
  ]
}
