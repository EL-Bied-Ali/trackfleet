{
  "name": "site-creator-vinext-starter",
  "version": "0.1.0",
  "private": true,
  "engines": { "node": ">=22.13.0" },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "build:vercel": "NITRO_PRESET=vercel vite build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --test tests/rendered-html.test.mjs",
    "test:sendatrack": "node --experimental-strip-types --test tests/sendatrack-normalize.test.mjs",
    "test:route-progress": "node --experimental-strip-types --test tests/route-progress.test.mjs",
    "test:delivery-events": "node --experimental-strip-types --test tests/delivery-events.test.mjs",
    "test:notifications": "node --experimental-strip-types --test tests/notification-queue.test.mjs",
    "test:notification-policy": "node --experimental-strip-types --test tests/notification-policy.test.mjs",
    "test:tracking-access": "node --experimental-strip-types --test tests/tracking-access.test.mjs",
    "test:public-provider-isolation": "node --test tests/public-tracking-provider-isolation.test.mjs",
    "test:customer-contact": "node --experimental-strip-types --test tests/customer-contact.test.mjs",
    "test:login-error": "node --experimental-strip-types --test tests/login-error.test.mjs",
    "test:origin-preference": "node --experimental-strip-types --test tests/origin-preference.test.mjs",
    "test:vehicle-linking": "node --experimental-strip-types --test tests/vehicle-linking.test.mjs",
    "test:delivery-vehicle-choice": "node --experimental-strip-types --test tests/delivery-vehicle-choice.test.mjs",
    "test:unassigned-trip-safety": "node --test tests/unassigned-trip-safety.test.mjs",
    "test:trip-suggestion": "node --experimental-strip-types --test tests/trip-suggestion.test.mjs",
    "test:tenant-isolation": "node --test tests/tenant-isolation.test.mjs",
    "test:known-sites": "node --experimental-strip-types --test tests/known-sites.test.mjs",
    "test:site-store": "node --experimental-strip-types --test tests/site-store.test.mjs",
    "test:delivery-site-resolution": "node --experimental-strip-types --test tests/delivery-site-resolution.test.mjs",
    "test:delivery-persistence": "node --test tests/delivery-persistence-contract.test.mjs",
    "test:stop-plans": "node --experimental-strip-types --test tests/truck-stop-plan.test.mjs",
    "test:stop-dwell": "node --experimental-strip-types --test tests/stop-dwell.test.mjs",
    "test:tour": "node --experimental-strip-types --test tests/multistop-tour.test.mjs",
    "test:tour-view": "node --experimental-strip-types --test tests/tour-view.test.mjs",
