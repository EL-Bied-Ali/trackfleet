    "test:route-template": "node --experimental-strip-types --test tests/route-template.test.mjs",
    "test:trip-record": "node --experimental-strip-types --test tests/trip-record.test.mjs",
    "test:trip-persistence": "node --test tests/trip-persistence-contract.test.mjs",
    "test:trip-history": "node --test tests/trip-history-api.test.mjs",
    "test:automation-readiness": "node --experimental-strip-types --test tests/automation-readiness.test.mjs",
    "test:automation-health": "node --experimental-strip-types --test tests/automation-health.test.mjs",
    "test:whatsapp-readiness": "node --test tests/whatsapp-readiness.test.mjs",
    "test:whatsapp-preview": "node --test tests/whatsapp-preview.test.mjs",
    "test:eta": "node --experimental-strip-types --test tests/eta-estimator.test.mjs",
    "test:eta-observation": "node --experimental-strip-types --test tests/eta-observation.test.mjs",
