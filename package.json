    "test:automation-delay": "node --experimental-strip-types --test tests/automation-delay.test.mjs",
    "test:automation-trip-sync": "node --test tests/automation-trip-sync.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.1.0",
    "drizzle-orm": "0.45.2",
    "maplibre-gl": "^6.3.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
