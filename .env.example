# SENDATRACK credentials must only be configured as protected server secrets.
SENDATRACK_ACCOUNT_ID=
SENDATRACK_USER=
SENDATRACK_PASSWORD=
SENDATRACK_API_URL=http://backend2.sendatrack.com/sendatrack/public/api/
# SENDATRACK currently exposes this integration over HTTP. TrackFleet blocks
# insecure provider transport by default. Set this to true only after explicitly
# accepting that SENDATRACK credentials/tokens will travel without TLS on the
# provider network path. Prefer HTTPS whenever the provider eventually supports it.
TRACKFLEET_ALLOW_INSECURE_SENDATRACK=false
# Optional: routes SENDATRACK calls through a relay (see relay/README.md)
# instead of calling backend2.sendatrack.com directly from the Worker.
# SENDATRACK's network rejects requests from Cloudflare/datacenter IPs, so
# this is required in production until that changes. The relay's address is
# normally registered dynamically (POST /api/sendatrack/relay) and does not
# need to be set here; SENDATRACK_RELAY_URL is only a static override for a
# fixed (named-tunnel) relay address, if one is ever set up.
SENDATRACK_RELAY_SECRET=
SENDATRACK_RELAY_URL=
# Required for production readiness. Generate a dedicated 32-byte random key
# and store its base64 value as a protected server secret. Do not reuse the
# SENDATRACK password as the production session-encryption key.
TRACKFLEET_ENCRYPTION_KEY=

# Optional raw telemetry retention override. Blank uses the safe default:
# keep full-resolution GPS for 7 days, downsample older raw positions to one
# point per 5 minutes, and remove raw positions after 30 days. ETA learning
# history is retained for at least 365 days. Explicit values must be 7..3650.
TRACKFLEET_TELEMETRY_RETENTION_DAYS=

# Runtime schema creation is intentionally disabled by default. Production
# requests must not spend their Cloudflare/Neon subrequest budget on CREATE or
# ALTER statements. Set this to true only for an explicit one-time bootstrap
# against a controlled Postgres database, never as a normal production setting.
TRACKFLEET_RUNTIME_SCHEMA_BOOTSTRAP=false

# Read-only D1 failover is readiness-gated. On Cloudflare, omitting this value
# authorizes failover by default; D1 is still never used unless readiness is
# green. Set false explicitly as the immediate kill switch. Vercel does not
# enable D1 failover by default.
TRACKFLEET_D1_READ_FAILOVER=false

# Continuous unloading time required after a fresh/stopped GPS fix enters the
# destination geofence. Defaults to 120 minutes; valid values are 15..720.
TRACKFLEET_UNLOAD_GRACE_MINUTES=120

# Authoritative persistent storage for production. Cloudflare and Vercel both
# use Neon/Postgres when DATABASE_URL is configured.
DATABASE_URL=

# Protect cron/maintenance routes. Schedulers send this as a Bearer token.
CRON_SECRET=

# WhatsApp Cloud API. Keep secrets server-side only.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Required by the production preflight so TrackFleet can verify the exact
# approved template before automation is enabled.
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_TEMPLATE_NAME=
# Required for automatic sends. Must exactly match Meta, e.g. fr or en_US.
WHATSAPP_TEMPLATE_LANGUAGE=
# Used only by the explicit manual demo route, never as an automatic customer fallback.
WHATSAPP_DEMO_RECIPIENT=
WHATSAPP_DEMO_ENABLED=false

# Automatic customer notifications stay disabled until explicitly enabled.
WHATSAPP_AUTOMATION_ENABLED=false
# ISO timestamp set at the moment automation is enabled. Events older than
# this boundary are acknowledged without being sent, preventing catch-up spam.
WHATSAPP_AUTOMATION_START_AT=
