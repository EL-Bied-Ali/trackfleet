{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "trackfleet",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-19",
  "compatibility_flags": ["nodejs_compat"],
  // SENDATRACK does not currently expose the TrackFleet API over HTTPS.
  // This explicit MVP override is monitored by /api/health and can be removed if TLS becomes available.
  "vars": {
    "TRACKFLEET_ALLOW_INSECURE_SENDATRACK": "true",
    // None of these is sensitive (price ids are public-ish, shown in
    // checkout URLs; PADDLE_CLIENT_TOKEN is a Paddle.js client-side token,
    // meant to be embedded in frontend JS by design -- not the same thing
    // as PADDLE_API_KEY; the environment flag just picks sandbox vs live
    // API base URL) -- PADDLE_API_KEY and PADDLE_WEBHOOK_SECRET are the
    // actual secrets, set via `wrangler secret put`, not here. Two tiers
    // (Standard: no WhatsApp, Pro: WhatsApp included) x two intervals --
    // see app/lib/paddle-checkout.ts for how these are selected.
    "PADDLE_PRICE_ID_STANDARD_MONTHLY": "pri_01m0wz9mx48pbva99e7m49gybx",
    "PADDLE_PRICE_ID_STANDARD_YEARLY": "pri_01m0wzcnbxfeet00z74zqbbp7m",
    "PADDLE_PRICE_ID_PRO_MONTHLY": "pri_01m0wzj256camj7jhdhfar1x80",
    "PADDLE_PRICE_ID_PRO_YEARLY": "pri_01m0wzta8j6ccv6pxnvp9p4a0g",
    "PADDLE_CLIENT_TOKEN": "test_c0dc60a90f3382db6753ed94448",
    "PADDLE_ENVIRONMENT": "sandbox",
    // Mailgun sending domain + From header for automatic customer
    // notification emails (app/lib/email-automation.ts) -- EMAIL_API_KEY
    // is the actual secret, set via `wrangler secret put`. mg.medinabelgique.com
    // is a verified custom domain (SPF/DKIM/tracking CNAME all "valid" in
    // Mailgun) -- unlike the earlier sandbox domain, this delivers to real
    // recipients, not just an authorized-recipients allowlist. A subdomain
    // (mg.) rather than the bare domain on purpose, so root-domain DNS stays
    // free for that domain's own website.
    "EMAIL_DOMAIN": "mg.medinabelgique.com",
    "EMAIL_FROM_ADDRESS": "TrackFleet <notifications@mg.medinabelgique.com>",
    // The shared WhatsApp Business number's own human-facing E.164 number
    // (not a secret -- meant to be given to customers). Shown on the
    // public tracking page so customers know what to text to open the 24h
    // free customer-service window manual sends need while
    // WHATSAPP_AUTOMATION_ENABLED stays off.
    "WHATSAPP_DISPLAY_NUMBER": "+32 470 91 57 61",
    // Comma-separated allowlist for /admin -- kept as a plain, versioned
    // config value rather than a secret on purpose: who has admin access is
    // exactly the kind of thing that should show up in git history/review,
    // not be silently changeable out-of-band. Knowing an email here grants
    // nothing by itself; access still requires controlling that Google
    // account (see app/lib/admin-auth.ts).
    "ADMIN_EMAILS": "ali.el.bied9898@gmail.com"
  },
  "triggers": {
    "crons": [
      "*/15 * * * *",
      "5,20,35,50 * * * *",
      "18 * * * *",
      "48 * * * *",
      "10,25,40,55 * * * *"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "trackfleet-db",
      "database_id": "47058ea5-8699-4c70-baa6-95ff52b425e8"
    }
  ],
  // Points at Supabase's own Postgres (the new primary, migrating off Neon
  // -- see app/lib/pg-client.ts). Provisioned via `wrangler hyperdrive
  // create`; update in place with `wrangler hyperdrive update` for any
  // future connection-string change (e.g. rotating the DB password),
  // rather than deleting/recreating this binding.
  //
  // Caching MUST stay disabled (`wrangler hyperdrive update <id>
  // --caching-disabled`, verify with `wrangler hyperdrive get <id>` ->
  // caching.disabled === true). This isn't expressible in this file --
  // Hyperdrive caching is server-side config on the binding itself, not
  // read from wrangler.jsonc, so re-running `hyperdrive create` (rather
  // than `update`) would silently default it back to enabled with a 60s
  // max_age. That default previously caused writes (INSERT ... RETURNING,
  // genuinely committed and echoed correctly) to be followed by GETs
  // serving stale pre-write data for up to 60s, since Hyperdrive never
  // invalidates cached reads on write. Root-caused and fixed live
  // 2026-09-03 after a tight sequential loop of POST /api/sites calls hit
  // exactly this window (see PR #303's description for the original
  // report). Fixed by disabling caching on the existing binding, not a
  // code change -- see app/lib/pg-client.ts for the read/write path this
  // protects.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "85e863a096284ceeaa742038a65a6135"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "SENDATRACK_TOKEN_CACHE",
      "id": "2f58714723c64b30b4c09b85cac053ad"
    }
  ]
}
