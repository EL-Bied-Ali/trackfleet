{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "trackfleet",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-19",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "TRACKFLEET_ALLOW_INSECURE_SENDATRACK": "true"
  },
  "triggers": {
    "crons": [
      "*/15 * * * *",
      "5,20,35,50 * * * *",
      "10,25,40,55 * * * *"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "trackfleet-db",
      "database_id": "47058ea5-8699-4c70-baa6-95ff52b425e8"
    }
  ]
}
