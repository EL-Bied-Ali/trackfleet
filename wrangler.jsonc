{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "trackfleet",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-19",
  "compatibility_flags": ["nodejs_compat"],
  // SENDATRACK does not currently expose the TrackFleet API over HTTPS.
  // This explicit MVP override is monitored by /api/health and can be removed if TLS becomes available.
  "vars": {
    "TRACKFLEET_ALLOW_INSECURE_SENDATRACK": "true",
    // Neither of these is sensitive (the price id is public-ish, shown in
    // checkout URLs; the environment flag just picks sandbox vs live API
    // base URL) -- PADDLE_API_KEY and PADDLE_WEBHOOK_SECRET are the actual
    // secrets, set via `wrangler secret put`, not here.
    "PADDLE_PRICE_ID": "pri_01m0wsa3maq3vxp55me576s135",
    "PADDLE_ENVIRONMENT": "sandbox"
  },
  "triggers": {
    "crons": [
      "*/5 * * * *",
      "2,7,12,17,22,27,32,37,42,47,52,57 * * * *",
      "*/15 * * * *",
      "5,20,35,50 * * * *",
      "10,25,40,55 * * * *"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "trackfleet-db",
      "database_id": "47058ea5-8699-4c70-baa6-95ff52b425e8"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "SENDATRACK_TOKEN_CACHE",
      "id": "2f58714723c64b30b4c09b85cac053ad"
    }
  ]
}
